+TEST_F(RelocatableStorageBackendTest, StreamedAdjacencySmallCrossPagePreservesOldPins) {
+    materializeNativeDatabase(); auto options = backendOptions(); options.open_mode = OpenMode::OPEN_EXISTING_FILE;
+    RelocatableStorageBackend backend(options); backend.open();
+    const auto nodes = backend.createLogicalNodes({{{"Source"}, {}}, {{"Target"}, {}}}); ASSERT_EQ(nodes.size(), 2U);
+    std::vector<uint64_t> sources(1024, nodes[0]), targets(1024, nodes[1]);
+    DeltaWork work; graph::debug::PerfTrace::ScopedObserver observer(&work, DeltaWork::observe);
+    const auto initial = append(backend, sources, targets); ASSERT_EQ(initial.size(), 1024U);
+    EXPECT_EQ(work.full, 1); auto old = backend.openLogicalGraphReadSnapshot();
+    ASSERT_EQ(old->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_OUTGOING, {}, 1100).edges.size(), 1024U);
+    work = {};
+    const std::array<uint64_t, 3> nextSources{nodes[0], nodes[0], nodes[1]}, nextTargets{nodes[1], nodes[0], nodes[0]};
+    const auto added = append(backend, nextSources, nextTargets); ASSERT_EQ(added.size(), 3U);
+    EXPECT_EQ(work.incremental, 1);
+    EXPECT_EQ(work.full, 0); EXPECT_GT(work.frames, 0); EXPECT_LE(work.frames, 8);
+    EXPECT_EQ(work.member_incremental, 1); EXPECT_EQ(work.member_full, 0);
+    EXPECT_GT(work.member_frames, 0); EXPECT_LE(work.member_frames, 8);
+    EXPECT_EQ(old->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_OUTGOING, {}, 1100).edges.size(), 1024U);
+    EXPECT_TRUE(old->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_INCOMING, {}, 1100).edges.empty());
+    auto now = backend.openLogicalGraphReadSnapshot();
+    EXPECT_EQ(now->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_OUTGOING, {}, 1100).edges.size(), 1026U);
+    EXPECT_EQ(now->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_INCOMING, {}, 1100).edges.size(), 2U);
+    EXPECT_EQ(now->readEdge(added[1]).source_node_id, now->readEdge(added[1]).target_node_id);
+    const auto statistics = backend.readLogicalGraphCardinalityStatistics(); ASSERT_TRUE(statistics); EXPECT_EQ(statistics->edge_count, 1027U);
+    old.reset(); now.reset(); backend.close(); backend.open();
+    now = backend.openLogicalGraphReadSnapshot(); EXPECT_EQ(now->readEdge(added[0]).target_node_id, nodes[1]);
+    now.reset(); EXPECT_NO_THROW((void)backend.verifyIntegrity()); backend.close();
+    auto stream = std::make_shared<std::fstream>(data_path_, std::ios::in | std::ios::binary);
+    auto io = std::make_shared<StorageIO>(stream, INVALID_FILE_HANDLE, INVALID_FILE_HANDLE, StorageIOAccessMode::SIOAM_READ_ONLY);
+    auto metadata = RelocatableMetadataStore::openReadOnly(io); auto pin = metadata->openSnapshot();
+    SlottedPagePool pool(io, *metadata, SharedPagePoolOpenMode::SPPOM_READ_ONLY);
+    BTreePageStore tree(pool, *metadata);
+    const auto root = metadata->findIndexRoot(pin, RSS_GLOBAL_ADJACENCY_INDEX_ID);
+    const auto page = tree.read(pin, root.root_page_id);
+    EXPECT_EQ(page.header().kind, BTreeNodeKind::BPN_INTERNAL);
+    EXPECT_GT(page.header().level, 0U);
+    pin.release();
+
