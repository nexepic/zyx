+// The larger companion remains in the separately run stress tier.
+TEST_F(RelocatableStorageBackendTest, OrdinaryIndexImagesSmallBatchesPreserveSnapshots) {
+    materializeNativeDatabase(); auto options = backendOptions(); options.open_mode = OpenMode::OPEN_EXISTING_FILE;
+    RelocatableStorageBackend backend(options); backend.open();
+    const auto nodes = backend.createLogicalNodes({{{"Source"}, {}}, {{"Target"}, {}}});
+    const std::vector<LogicalGraphEdgeCreateRequest> batch(16, {nodes[0], nodes[1], "FRESH_BATCH", {}});
+    DeltaWork work; graph::debug::PerfTrace::ScopedObserver observer(&work, DeltaWork::observe);
+    static_cast<void>(backend.createLogicalEdges(batch)); auto old = backend.openLogicalGraphReadSnapshot();
+    for (size_t round = 0; round < 2; ++round) {
+        EXPECT_EQ(backend.createLogicalEdges(batch).size(), 16U);
+        const auto counts = backend.readLogicalGraphCardinalityStatistics(); ASSERT_TRUE(counts);
+        EXPECT_EQ(counts->edge_count, (round + 2U) * 16U);
+        EXPECT_EQ(old->scanAdjacentEdges(nodes[0], LogicalGraphReadDirection::LGRD_OUTGOING, {}, 32).edges.size(), 16U);
+    }
+    EXPECT_GE(work.ordinary_plans, 2); EXPECT_GE(work.ordinary_member_plans, 2); EXPECT_GT(work.fresh_pools, 0);
+    old.reset(); EXPECT_NO_THROW((void)backend.verifyIntegrity()); backend.close(); backend.open();
+    const auto counts = backend.readLogicalGraphCardinalityStatistics(); ASSERT_TRUE(counts); EXPECT_EQ(counts->edge_count, 48U);
+    EXPECT_NO_THROW((void)backend.verifyIntegrity()); backend.close();
+}
