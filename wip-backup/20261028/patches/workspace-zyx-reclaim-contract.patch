+TEST_F(RelocatableMetadataPagePoolTest, UnprovenReconciliationPreservesCurrentAndPinnedRoots) {
+    const auto initial = initialBlock(); SuperblockFile bootstrap(io); bootstrap.initializeNew(initial);
+    MetadataPageFile pages(io, initial); MetadataPagePoolAllocator allocator(io, initial); CatalogTree tree(pages, allocator);
+    const auto old = tree.upsertAndPublish(bootstrap, initial, std::vector{poolEntry(100, 2)}, LogSequenceNumber(2));
+    const auto current = tree.upsertAndPublish(bootstrap, old, std::vector{poolEntry(101, 3)}, LogSequenceNumber(3));
+    (void)allocator.allocatePage(Generation(3));
+    allocator.reclaimUnreachable(current, std::array{old}, false);
+    EXPECT_EQ(tree.find(old, SegmentId(1)).physical_slot, PhysicalSlotId(100));
+    EXPECT_EQ(tree.find(current, SegmentId(1)).physical_slot, PhysicalSlotId(101));
+    const auto pinned = allocator.stats().allocated_pages;
+    allocator.reclaimUnreachable(current, {}, true);
+    EXPECT_LT(allocator.stats().allocated_pages, pinned);
+    EXPECT_EQ(tree.find(current, SegmentId(1)).physical_slot, PhysicalSlotId(101));
 }
