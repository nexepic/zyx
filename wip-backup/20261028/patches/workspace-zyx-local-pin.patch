+TEST_F(RelocatableMetadataSnapshotRegistryTest, ForeignPinBlocksReclaimUntilOwnerReleases) {
+    const Superblock initial = superblock(1, 1);
+    SuperblockFile bootstrap(io); bootstrap.initializeNew(initial);
+    MetadataPageFile pages(io, initial); MetadataPagePoolAllocator allocator(io, initial);
+    CatalogTree tree(pages, allocator); auto domain = makeMetadataSnapshotCoordination();
+    MetadataSnapshotRegistry owner(bootstrap, {}, {}, {}, domain), writerRegistry(bootstrap, {}, {}, {}, domain);
+    { auto writer = writerRegistry.beginWrite();
+      tree.upsertAndPublish(bootstrap, bootstrap.recover(), std::vector{entry(100, 2, 2)}, LogSequenceNumber(2)); }
+    auto pin = owner.openSnapshot();
+    EXPECT_EQ(owner.localSnapshotCount(), 1U); EXPECT_EQ(writerRegistry.localSnapshotCount(), 0U);
+    { auto writer = writerRegistry.beginWrite();
+      auto next = tree.upsertAndPublish(bootstrap, bootstrap.recover(), std::vector{entry(101, 3, 3)}, LogSequenceNumber(3));
+      writerRegistry.reclaimAfterPublication(writer, allocator, next); }
+    EXPECT_EQ(allocator.stats().allocated_pages, 4U);
+    EXPECT_EQ(tree.find(pin.superblock(), SegmentId(1)).physical_slot, PhysicalSlotId(100));
+    pin.release();
+    { auto writer = writerRegistry.beginWrite(); writerRegistry.reclaimAfterPublication(writer, allocator, bootstrap.recover()); }
+    EXPECT_EQ(allocator.stats().allocated_pages, 2U);
+}
