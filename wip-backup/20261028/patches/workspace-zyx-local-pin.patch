+TEST_F(RelocatableStorageBackendTest, ConcurrentForeignClosePreservesPinnedOwner) {
+    const NativeGraphFixture fixture = materializeNativeGraphFixture();
+    auto options = backendOptions(); options.open_mode = OpenMode::OPEN_EXISTING_FILE;
+    RelocatableStorageBackend owner(options); owner.open();
+    RelocatableStorageBackend other(options); other.open();
+    auto pin = owner.openSnapshot();
+    std::barrier gate(2);
+    auto closed = std::async(std::launch::async, [&] { gate.arrive_and_wait(); other.close(); });
+    gate.arrive_and_wait();
+    EXPECT_EQ(owner.readNode(pin, fixture.person_node_id).node_id, fixture.person_node_id);
+    EXPECT_NO_THROW(closed.get());
+    EXPECT_EQ(owner.readNode(pin, fixture.person_node_id).node_id, fixture.person_node_id);
+    EXPECT_THROW(owner.close(), std::logic_error);
+    pin.release(); owner.close();
+}
+
+TEST_F(RelocatableStorageBackendTest, ClosingAnotherHandlePreservesOwningSnapshotAndReopen) {
+    const NativeGraphFixture fixture = materializeNativeGraphFixture();
+    auto options = backendOptions(); options.open_mode = OpenMode::OPEN_EXISTING_FILE;
+    RelocatableStorageBackend owner(options); owner.open();
+    RelocatableStorageBackend other(options); other.open();
+    auto pin = owner.openSnapshot();
+    EXPECT_THROW(owner.close(), std::logic_error);
+    EXPECT_NO_THROW(other.close());
+    EXPECT_EQ(owner.readNode(pin, fixture.person_node_id).node_id, fixture.person_node_id);
+    other.open();
+    auto otherPin = other.openSnapshot();
+    EXPECT_EQ(other.readNode(otherPin, fixture.person_node_id).node_id, fixture.person_node_id);
+    otherPin.release(); other.close();
+    EXPECT_EQ(owner.readNode(pin, fixture.person_node_id).node_id, fixture.person_node_id);
+    pin.release(); owner.close();
 }
 
