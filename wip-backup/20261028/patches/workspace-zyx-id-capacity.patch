+TEST_F(RelocatableMetadataStoreValidationTest, IdLeaseCapacityPoolPreservesPinnedGraphRoots) {
+    auto store = RelocatableMetadataStore::initializeNew(io, initialSuperblock());
+    const Superblock initial = store->migratePageDirectoryToBootstrap(LogSequenceNumber(2U));
+    MetadataPageFile pages(io, initial);
+    const auto dataRoot = pages.readPageDirectoryBootstrap(initial.page_directory_root).data_page_directory_root;
+    std::vector<MetadataSnapshotPin> pins;
+    bool expanded = false;
+    graph::debug::PerfTrace::ScopedObserver observer(&expanded, [](void *owner, std::string_view key, int64_t, bool) noexcept {
+        if (key == "native_graph.write.id_capacity_pool") *static_cast<bool *>(owner) = true;
+    });
+    for (size_t index = 0; index < 128U && !expanded; ++index) {
+        pins.push_back(store->openSnapshot());
+        const auto lease = store->reserveNativeGraphLogicalIds(1U, 0U);
+        EXPECT_EQ(lease.superblock.node_entity_directory_root, initial.node_entity_directory_root);
+        EXPECT_EQ(lease.superblock.edge_entity_directory_root, initial.edge_entity_directory_root);
+        EXPECT_EQ(lease.superblock.entity_property_directory_root, initial.entity_property_directory_root);
+        EXPECT_EQ(pages.readPageDirectoryBootstrap(lease.superblock.page_directory_root).data_page_directory_root, dataRoot);
+    }
+    ASSERT_TRUE(expanded) << "the test must cross the frame-capacity boundary";
+    EXPECT_EQ(pins.front().superblock(), initial);
+    pins.clear();
+    store.reset();
+    auto reopened = RelocatableMetadataStore::open(io);
+    auto after = reopened->openSnapshot();
+    EXPECT_EQ(after.superblock().node_entity_directory_root, initial.node_entity_directory_root);
+    EXPECT_EQ(pages.readPageDirectoryBootstrap(after.superblock().page_directory_root).data_page_directory_root, dataRoot);
+}
