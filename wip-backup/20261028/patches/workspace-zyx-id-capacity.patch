+TEST_F(RelocatableMetadataStoreValidationTest, IdLeaseCapacityRespectsFileLimitAndKeepsPublishedState) {
+    const Superblock initial = initialSuperblock();
+    const uint64_t limit = initial.data_region_offset + 8U * RSS_SEGMENT_SIZE;
+    io = std::make_shared<StorageIO>(dataFile, INVALID_FILE_HANDLE, INVALID_FILE_HANDLE,
+                                      StorageIOAccessMode::SIOAM_READ_WRITE, limit);
+    auto store = RelocatableMetadataStore::initializeNew(io, initial);
+    static_cast<void>(store->migratePageDirectoryToBootstrap(LogSequenceNumber(2U)));
+    std::vector<MetadataSnapshotPin> pins;
+    Superblock before;
+    bool refused = false;
+    for (size_t index = 0; index < 256U && !refused; ++index) {
+        pins.push_back(store->openSnapshot());
+        before = pins.back().superblock();
+        try { static_cast<void>(store->reserveNativeGraphLogicalIds(1U, 0U)); }
+        catch (const StorageFileLimitExceeded &) { refused = true; }
+    }
+    ASSERT_TRUE(refused) << "pinned leases must reach the bounded file limit";
+    EXPECT_LE(io->fileSize(), limit);
+    auto after = store->openSnapshot();
+    EXPECT_EQ(after.superblock(), before);
+    after.release();
+    pins.clear();
+    store.reset();
+    auto reopened = RelocatableMetadataStore::open(io);
+    auto snapshot = reopened->openSnapshot();
+    EXPECT_EQ(snapshot.superblock(), before);
+}
