+TEST_F(RelocatableMetadataStoreValidationTest, IdLeaseCapacityPoolFailureRollsBackBeforePublication) {
+    auto store = RelocatableMetadataStore::initializeNew(io, initialSuperblock());
+    static_cast<void>(store->migratePageDirectoryToBootstrap(LogSequenceNumber(2U)));
+    std::vector<MetadataSnapshotPin> pins;
+    MetadataPublishOptions options;
+    struct Observation { bool hit = false; bool armed = true; MetadataPublishOptions *options; } observation{false, true, &options};
+    graph::debug::PerfTrace::ScopedObserver observer(&observation, [](void *owner, std::string_view key, int64_t, bool) noexcept {
+        auto &state = *static_cast<Observation *>(owner);
+        if (state.armed && key == "native_graph.write.id_capacity_pool") {
+            state.hit = true;
+            state.options->bootstrap_failpoint = BootstrapPublishFailpoint::BPF_BEFORE_INACTIVE_WRITE;
+        }
+    });
+    Superblock beforeFailure;
+    bool failed = false;
+    for (size_t index = 0; index < 128U && !failed; ++index) {
+        pins.push_back(store->openSnapshot());
+        beforeFailure = pins.back().superblock();
+        try { static_cast<void>(store->reserveNativeGraphLogicalIds(1U, 0U, options)); }
+        catch (const BootstrapPublishInterrupted &) { failed = true; }
+    }
+    ASSERT_TRUE(observation.hit);
+    ASSERT_TRUE(failed);
+    auto afterFailure = store->openSnapshot();
+    EXPECT_EQ(afterFailure.superblock(), beforeFailure);
+    afterFailure.release();
+    observation.armed = false;
+    options.bootstrap_failpoint = BootstrapPublishFailpoint::BPF_NONE;
+    const auto retry = store->reserveNativeGraphLogicalIds(1U, 0U, options);
+    EXPECT_EQ(retry.nodes.first_id, beforeFailure.next_logical_node_id);
+    EXPECT_EQ(retry.superblock.node_entity_directory_root, beforeFailure.node_entity_directory_root);
+    pins.clear();
+    store.reset();
+    auto reopened = RelocatableMetadataStore::open(io);
+    auto snapshot = reopened->openSnapshot();
+    EXPECT_EQ(snapshot.superblock().next_logical_node_id, retry.superblock.next_logical_node_id);
+}
