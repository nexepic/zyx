+TEST_F(VectorizedNodeScanIntegrationTest, TopKMatchesCompleteSortForNullMissingAndTies) {
+    (void)execute("CREATE (:Person {name: 'Tie', score: 20})");
+    (void)execute("CREATE (:Person {name: 'NullScore', score: null})");
+    const auto names = [](const query::QueryResult &result) {
+        std::vector<std::string> out;
+        for (const auto &row : result.getRows()) out.push_back(row.at("name").asPrimitive().toString());
+        return out;
+    };
+    for (const std::string direction : {"ASC", "DESC"}) {
+        const std::string query = "MATCH (u:Person) RETURN u.name AS name ORDER BY u.score " + direction;
+        const auto full = names(execute(query));
+        const auto top = names(execute(query + " LIMIT 4"));
+        ASSERT_EQ(full.size(), 6U); ASSERT_EQ(top.size(), 4U);
+        EXPECT_EQ(top, (std::vector<std::string>(full.begin(), full.begin() + 4)));
+        const auto missing = std::find(full.begin(), full.end(), "MissingAge");
+        const auto explicitNull = std::find(full.begin(), full.end(), "NullScore");
+        ASSERT_NE(missing, full.end()); ASSERT_NE(explicitNull, full.end());
+        if (direction == "ASC") { EXPECT_GE(missing - full.begin(), 4); EXPECT_GE(explicitNull - full.begin(), 4); }
+        else { EXPECT_LT(missing - full.begin(), 2); EXPECT_LT(explicitNull - full.begin(), 2); }
+    }
+}
