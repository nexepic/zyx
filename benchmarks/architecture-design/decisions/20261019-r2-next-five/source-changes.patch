+++ b/tests/src/storage/relocatable/backend/test_RelocatableDirectPropertyBatch.cpp
@@ -104,0 +105,42 @@ TEST_F(RelocatableStorageBackendTest, NativeDirectFilterGroupAndDistinctReturnEx
+
+TEST_F(RelocatableStorageBackendTest, DirectPropertyCellsIsolateOldPinsAcrossAnotherHandlePublicationAndFileGrowth) {
+    const auto fixture = materializeNativeGraphFixture();
+    auto options = backendOptions(); options.open_mode = OpenMode::OPEN_EXISTING_FILE;
+    RelocatableStorageBackend reader(options), writer(options); reader.open(); writer.open();
+    auto old = reader.openLogicalGraphReadSnapshot();
+    const std::array<std::string_view, 2> keys{"alpha", "rank"};
+    const auto read = [&](LogicalGraphReadSnapshot &snapshot, const std::vector<uint64_t> &ids) {
+        std::map<std::pair<size_t, size_t>, PropertyValue> result;
+        snapshot.readNodePropertyCellsSortedWithAdmission(ids, keys,
+            [&](size_t row, size_t column, std::optional<PropertyValue> value) {
+                if (value) EXPECT_TRUE(result.emplace(std::pair{row,column}, std::move(*value)).second);
+            }, [](size_t) {});
+        return result;
+    };
+    EXPECT_EQ(read(*old, {fixture.person_node_id}).at({0,0}), PropertyValue(42));
+    const auto bytes = std::filesystem::file_size(data_path_);
+    std::vector<LogicalGraphNodeCreateRequest> requests;
+    for (int64_t i = 0; i < 64; ++i) {
+        std::string body(65536U, 'x'); body.replace(0, 8, std::to_string(i));
+        requests.push_back({{"Growing"}, {{"rank", PropertyValue(i)}, {"body", PropertyValue(body)}}});
+    }
+    std::vector<uint64_t> created;
+    ASSERT_NO_THROW(created = writer.createLogicalNodes(requests));
+    ASSERT_EQ(created.size(), 64U);
+    EXPECT_GT(std::filesystem::file_size(data_path_), bytes);
+    const std::vector<uint64_t> gather{fixture.person_node_id, created.back()};
+    std::map<std::pair<size_t,size_t>, PropertyValue> oldValues;
+    ASSERT_NO_THROW(oldValues = read(*old, gather));
+    EXPECT_EQ(oldValues.at({0,0}), PropertyValue(42));
+    EXPECT_FALSE(oldValues.contains({1,1}));
+    std::unique_ptr<LogicalGraphReadSnapshot> current;
+    ASSERT_NO_THROW(current = reader.openLogicalGraphReadSnapshot());
+    std::map<std::pair<size_t,size_t>, PropertyValue> currentValues;
+    ASSERT_NO_THROW(currentValues = read(*current, gather));
+    EXPECT_EQ(currentValues.at({0,0}), PropertyValue(42));
+    EXPECT_EQ(currentValues.at({1,1}), PropertyValue(63));
+    current.reset(); old.reset(); writer.close(); reader.close();
+    RelocatableStorageBackend reopened(options); reopened.open();
+    auto fresh = reopened.openLogicalGraphReadSnapshot();
+    EXPECT_EQ(read(*fresh, gather), currentValues);
+}
diff --git a/tests/src/storage/relocatable/metadata/test_MetadataPageReadContext.cpp b/tests/src/storage/relocatable/metadata/test_MetadataPageReadContext.cpp
index 8a983071..c0844ed2 100644
--- a/tests/src/storage/relocatable/metadata/test_MetadataPageReadContext.cpp
+++ b/tests/src/storage/relocatable/metadata/test_MetadataPageReadContext.cpp
@@ -737,0 +738,55 @@ TEST_F(MetadataPageReadContextTest, DecoderAdmissionDoesNotEvictPagesFundedByAno
+
+// A view owns an immutable decoded image, not a raw buffer-pool pin. Invalidating
+// the lookup cache must leave an already borrowed image alive and unchanged.
+TEST_F(MetadataPageReadContextTest, RadixViewsShareHitsAndSurviveInvalidationWithoutStaleLookup) {
+    MetadataPageFile pages(io, root);
+    const auto ref = writeRadix(pages, 1U);
+    auto context = std::make_shared<MetadataPageReadContext>(root);
+    MetadataPageReadContext::Scope scope(context, *io);
+    static_cast<void>(pages.readMetadataRadixUnresolvedView(ref));
+    const auto held = pages.readMetadataRadixUnresolvedView(ref);
+    const auto shared = pages.readMetadataRadixUnresolvedView(ref);
+    EXPECT_EQ(held.get(), shared.get());
+    EXPECT_FALSE(held->logical_children_resolved);
+    auto replacement = *held;
+    replacement.page_id = MetadataPageId(77U);
+    pages.writeMetadataRadix(ref, replacement);
+    const auto fresh = pages.readMetadataRadixUnresolvedView(ref);
+    EXPECT_EQ(fresh->page_id, MetadataPageId(77U));
+    EXPECT_EQ(held->page_id, MetadataPageId(1U));
+    EXPECT_NE(fresh.get(), held.get());
+    const std::byte bad{0}; io->writeAt(pages.pageOffset(ref), &bad, 1U);
+    EXPECT_THROW(pages.readMetadataRadixUnresolvedView(ref), FormatException);
+    EXPECT_EQ(held->page_id, MetadataPageId(1U));
+    EXPECT_THROW(pages.readMetadataRadixUnresolvedView(ref, static_cast<BufferPoolReadHint>(255U)), FormatException);
+}
+
+TEST_F(MetadataPageReadContextTest, RadixViewsMeasureBorrowedAndCopiedFixedBytesSeparately) {
+    MetadataPageFile pages(io, root);
+    const auto ref = writeRadix(pages, 1U);
+    auto context = std::make_shared<MetadataPageReadContext>(root);
+    MetadataPageReadContext::Scope scope(context, *io);
+    static_cast<void>(pages.readMetadataRadixUnresolvedView(ref));
+    graph::debug::PerfTrace::setValueCollectionEnabled(true);
+    for (size_t i = 0; i < 10U; ++i) static_cast<void>(pages.readMetadataRadixUnresolvedView(ref));
+    auto trace = graph::debug::PerfTrace::snapshotAndReset();
+    EXPECT_EQ(trace.at("native_graph.read.decoded_metadata_borrow_fixed_bytes").totalValue, 10U * sizeof(MetadataRadixPage));
+    EXPECT_FALSE(trace.contains("native_graph.read.decoded_metadata_copy_fixed_bytes"));
+    EXPECT_FALSE(trace.contains("native_graph.read.metadata_decodes.radix"));
+    for (size_t i = 0; i < 10U; ++i) static_cast<void>(pages.readMetadataRadixUnresolved(ref));
+    trace = graph::debug::PerfTrace::snapshotAndReset();
+    EXPECT_EQ(trace.at("native_graph.read.decoded_metadata_copy_fixed_bytes").totalValue, 10U * sizeof(MetadataRadixPage));
+    EXPECT_FALSE(trace.contains("native_graph.read.metadata_decodes.radix"));
+}
+
+TEST_F(MetadataPageReadContextTest, RadixViewsWithZeroCacheAndFutureReferencesRemainAuthenticated) {
+    MetadataPageFile pages(io, root);
+    const auto ref = writeRadix(pages, 1U, 2U);
+    auto context = std::make_shared<MetadataPageReadContext>(root, 0U);
+    MetadataPageReadContext::Scope scope(context, *io);
+    EXPECT_EQ(pages.readMetadataRadixUnresolvedView(ref)->generation, Generation(2U));
+    EXPECT_EQ(context->size(), 0U);
+    auto wrong = ref; wrong.generation = Generation(1U);
+    EXPECT_THROW(pages.readMetadataRadixUnresolvedView(wrong), FormatException);
+    EXPECT_EQ(context->size(), 0U);
+}
