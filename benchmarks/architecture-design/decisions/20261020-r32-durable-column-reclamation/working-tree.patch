+/**
+ * @file HybridPropertyImmutablePreparation.hpp
+ * @brief Metadata-owned private LargeValue frames for native field conversion.
+ * Copyright (c) 2026 Nexepic. Licensed under Apache-2.0.
+ */
+#pragma once
+#include "graph/storage/relocatable/metadata/MetadataWriteBatch.hpp"
+#include "graph/storage/relocatable/property/HybridPropertyLargeFieldPreparation.hpp"
+
+namespace graph::storage {
+// The enclosing metadata writer owns allocation and publication. This object
+// prepares complete immutable frames and routes without writing any file bytes;
+// its pool reservations belong to the same batch as the field/index images.
+class HybridPropertyImmutablePreparation final {
+    friend class RelocatableMetadataStore;
+    struct Frame {
+        CatalogEntry pool;
+        PageLocation location;
+        PageOwnerHeader owner;
+        utils::OwnedVector<std::byte> payload;
+    };
+    struct Placement { CatalogEntry pool; PageLocation location; PageOwnerKind kind; };
+    utils::OwnedVector<Frame> frames_;
+    utils::OwnedVector<LargeValueManifestLocation> manifests_;
+    size_t data_frames_ = 0;
+
+    template<class AllocatePool, class Checkpoint>
+    HybridPropertyImmutablePreparation(MetadataWriteBatch &batch, LargeValueStore &values,
+        std::span<const HybridPropertyLargeFieldPreparation> proposals,
+        const std::shared_ptr<std::pmr::memory_resource> &memory,
+        AllocatePool &&allocatePool, Checkpoint &&checkpoint)
+        : frames_(utils::OwnedPmrAllocator<Frame>(memory)),
+          manifests_(utils::OwnedPmrAllocator<LargeValueManifestLocation>(memory)) {
+        hybrid_property_detail::require(bool(memory), "native immutable images require their conversion account");
+        utils::OwnedAllocationScope scope(memory);
+        CatalogEntry dataPool, manifestPool;
+        size_t dataUsed = RSS_PAGE_POOL_DATA_FRAME_COUNT, manifestUsed = RSS_PAGE_POOL_DATA_FRAME_COUNT;
+        const auto allocateRange = [&](size_t count) {
+            PageId first;
+            for (size_t i = 0; i < count; ++i) {
+                checkpoint();
+                const auto page = batch.allocateLogicalPageId();
+                if (!i) first = page;
+                else hybrid_property_detail::require(page.value() - first.value() == i,
+                    "native immutable page range lost its batch identity sequence");
+            }
+            return first;
+        };
+        for (const auto &proposal : proposals) {
+            checkpoint();
+            hybrid_property_detail::require(proposal.databaseId() == batch.current().database_id &&
+                proposal.sourceGeneration() == batch.current().generation,
+                "native immutable proposal has a foreign or stale source fence");
+            if (proposal.reused()) continue;
+            // This coordinator currently proposes RAW/32K new values. Bound the
+            // existing standard-vector encoder's chunk/frame/manifest frontier
+            // before invoking it; retained images use actual owned allocations.
+            hybrid_property_detail::require(proposal.reference().codec == LargeValueCodec::LVC_RAW,
+                "native immutable preparation requires its registered RAW encoding");
+            constexpr size_t scratchBytes = 6U * RSS_LARGE_VALUE_EXTENT_32K_BYTES +
+                16U * RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES +
+                4U * RSS_LARGE_VALUE_MANIFEST_MAX_CHUNKS * sizeof(LargeValueChunk) +
+                16U * RSS_LARGE_VALUE_MAX_MEDIA_TYPE_BYTES + 4096U;
+            utils::OwnedHeapReservation scratch(memory, scratchBytes);
+            LargeValueStreamedMaterializationRequest request;
+            request.reference = proposal.reference(); request.logical_bytes = proposal.payload();
+            request.data_page_count = proposal.newDataPages(); request.manifest_page_count = proposal.newManifestPages();
+            request.first_data_page_id = allocateRange(request.data_page_count);
+            request.first_manifest_page_id = allocateRange(request.manifest_page_count);
+            hybrid_property_detail::require(request.first_manifest_page_id.isValid(), "native value has no manifest range");
+            utils::OwnedVector<Placement> placements{utils::OwnedPmrAllocator<Placement>(memory)};
+            placements.reserve(request.data_page_count + request.manifest_page_count);
+            const auto place = [&](PageId first, size_t count, bool data) {
+                auto &pool = data ? dataPool : manifestPool;
+                auto &used = data ? dataUsed : manifestUsed;
+                for (size_t i = 0; i < count; ++i) {
+                    checkpoint();
+                    if (used == RSS_PAGE_POOL_DATA_FRAME_COUNT) {
+                        pool = allocatePool(data ? SegmentKind::SGK_LARGE_VALUE_DATA_POOL :
+                            SegmentKind::SGK_LARGE_VALUE_MANIFEST_POOL, data ? RSS_LARGE_VALUE_SHARED_DATA_POOL_OWNER_ID :
+                            RSS_LARGE_VALUE_SHARED_MANIFEST_POOL_OWNER_ID);
+                        used = 0;
+                    }
+                    placements.push_back({pool, {PageId(first.value() + i), pool.segment_id,
+                        uint16_t(RSS_PAGE_POOL_FIRST_DATA_FRAME + used++), pool.generation, 0},
+                        data ? PageOwnerKind::POK_LARGE_VALUE_DATA : PageOwnerKind::POK_LARGE_VALUE_MANIFEST});
+                }
+            };
+            place(request.first_data_page_id, request.data_page_count, true);
+            place(request.first_manifest_page_id, request.manifest_page_count, false);
+            const auto placementFor = [&](PageId id, PageOwnerKind kind) -> const Placement & {
+                const auto found = std::lower_bound(placements.begin(), placements.end(), id,
+                    [](const Placement &placement, PageId page) { return placement.location.page_id < page; });
+                hybrid_property_detail::require(found != placements.end() && found->location.page_id == id && found->kind == kind,
+                    "native immutable frame lost its assigned placement");
+                return *found;
+            };
+            const auto resolve = [&](PageId id, PageOwnerKind kind) {
+                checkpoint(); const auto &placement = placementFor(id, kind);
+                return PageOwnerHeader{id, proposal.reference().value_id.value(), kind, 0,
+                    RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, placement.pool.generation, batch.checkpointLsn()};
+            };
+            const size_t before = frames_.size();
+            const auto retain = [&](const PageOwnerHeader &owner, std::vector<std::byte> bytes, PageOwnerKind kind) {
+                checkpoint(); const auto &placement = placementFor(owner.page_id, kind);
+                hybrid_property_detail::require(PageOwnerHeaderCodec::encode(owner) ==
+                    PageOwnerHeaderCodec::encode(resolve(owner.page_id, kind)) && bytes.size() == RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES,
+                    "native immutable frame changed its assigned owner or width");
+                utils::OwnedVector<std::byte> payload(bytes.begin(), bytes.end(), utils::OwnedPmrAllocator<std::byte>(memory));
+                frames_.push_back({placement.pool, placement.location, owner, std::move(payload)});
+                data_frames_ += kind == PageOwnerKind::POK_LARGE_VALUE_DATA;
+            };
+            values.materializeStreamedValue(request, batch.checkpointLsn(), std::ref(resolve), std::ref(retain));
+            hybrid_property_detail::require(frames_.size() - before == placements.size(),
+                "native immutable encoder did not emit every assigned frame");
+            manifests_.push_back({proposal.reference().value_id, request.first_manifest_page_id,
+                placementFor(request.first_manifest_page_id, PageOwnerKind::POK_LARGE_VALUE_MANIFEST).pool.generation});
+        }
+        checkpoint();
+    }
+public:
+    [[nodiscard]] size_t dataFrameCount() const noexcept { return data_frames_; }
+    [[nodiscard]] size_t manifestFrameCount() const noexcept { return frames_.size() - data_frames_; }
+};
+} // namespace graph::storage
diff --git a/include/graph/storage/relocatable/metadata/HybridPropertyRowPreparation.hpp b/include/graph/storage/relocatable/metadata/HybridPropertyRowPreparation.hpp
new file mode 100644
index 00000000..f8a4963f
--- /dev/null
+++ b/include/graph/storage/relocatable/metadata/HybridPropertyRowPreparation.hpp
@@ -0,0 +1,113 @@
+/**
+ * @file HybridPropertyRowPreparation.hpp
+ * @brief Accounted native hybrid-to-ROW source preparation for one group.
+ * Copyright (c) 2026 Nexepic. Licensed under Apache-2.0.
+ */
+#pragma once
+#include "graph/query/execution/MaterializedByteBudget.hpp"
+#include "graph/storage/relocatable/entity/EntityPageStore.hpp"
+#include "graph/storage/relocatable/property/HybridPropertyGroupConversion.hpp"
+#include "graph/storage/relocatable/property/HybridPropertyValueReader.hpp"
+
+namespace graph::storage {
+// Inverse conversion preparation only: no IDs, pages, roots or retirement are
+// published here. The enclosing writer must fence this source generation and
+// install ROW roots, erase native directories and retire storage atomically.
+class HybridPropertyRowPreparation final {
+    // Keep decoded standard-container credit until after every returned value
+    // is destroyed. The thread-local decode scope exists only in construction.
+    utils::OwnedHeapReservation decoded_credit_;
+    utils::OwnedVector<PropertyCollectionRoot> rows_;
+    DatabaseId database_id_{};
+    Generation source_generation_{};
+    HybridPropertyGroupRecord source_group_;
+public:
+    HybridPropertyRowPreparation(const HybridPropertyReadContext &context,
+        const MetadataSnapshotPin &snapshot, RelocatableMetadataStore &metadata, EntityPageStore &entities,
+        EntityPropertyOwnerKind kind, uint64_t groupId, std::shared_ptr<std::pmr::memory_resource> memory,
+        LargeValueStore *largeValues = nullptr, const CancellationCheckpoint *cancellation = nullptr)
+        : decoded_credit_(memory), rows_(utils::OwnedPmrAllocator<PropertyCollectionRoot>(memory)) {
+        if (!RSS_HYBRID_PROPERTY_FORMAT_ENABLED)
+            throw FormatException(FormatError::FERR_UNSUPPORTED_VERSION, "native inverse property conversion is disabled");
+        const auto account = std::dynamic_pointer_cast<query::execution::MaterializedByteBudget>(memory);
+        constexpr size_t cap = 1024U * 1024U;
+        hybrid_property_detail::require(account && account->used() <= cap && account->available() <= cap - account->used() &&
+            context.usesSnapshot(snapshot) && metadata.ownsSnapshot(snapshot) && entities.usesMetadataStore(metadata) &&
+            (!largeValues || largeValues->usesMetadataStore(metadata)) && hybrid_property_detail::validKind(kind) &&
+            groupId && groupId <= RSS_HYBRID_MAX_GROUP_ID,
+            "native inverse conversion requires one source pin, group and bounded conversion account");
+        utils::OwnedAllocationScope allocation(memory);
+        const auto check = [&] { context.checkpoint(); if (cancellation) cancellation->check(); };
+        utils::OwnedHeapReservation boundaryCredit(memory);
+        const auto boundary = [&](size_t bytes) { boundaryCredit.set(bytes); };
+        check();
+        const auto first = (groupId - 1U) * RSS_HYBRID_GROUP_CAPACITY + 1U;
+        const auto group = context.groupRecord({kind, first}, std::ref(boundary));
+        hybrid_property_detail::require(bool(group), "native inverse conversion requires an installed source group");
+        boundaryCredit.set(0);
+        if (group->memberships > HybridPropertyGroupConversion::MAX_MEMBERSHIPS)
+            throw std::length_error("native inverse conversion exceeds its membership bound");
+        source_group_ = *group;
+        database_id_ = snapshot.superblock().database_id; source_generation_ = snapshot.superblock().generation;
+        struct Owner { EntityPropertyKey key; size_t fields; };
+        utils::OwnedVector<Owner> owners{utils::OwnedPmrAllocator<Owner>(memory)};
+        owners.reserve(std::popcount(group->live));
+        size_t memberships = 0; uint64_t live = 0;
+        for (unsigned slot = 0; slot < RSS_HYBRID_GROUP_CAPACITY && first + slot <= RSS_HYBRID_MAX_ENTITY_ID; ++slot) {
+            check(); const EntityPropertyKey owner{kind, first + slot};
+            const auto summary = context.visitOwner(owner, HybridPropertyGroupConversion::MAX_MEMBERSHIPS + 1U,
+                [](uint32_t, HybridPropertySource) { return true; }, std::ref(boundary));
+            boundaryCredit.set(0);
+            hybrid_property_detail::require(summary.routed && summary.complete &&
+                (summary.owner_live || !summary.fields), "native inverse conversion has an incomplete or dead source owner");
+            if (summary.fields > HybridPropertyGroupConversion::MAX_MEMBERSHIPS - memberships)
+                throw std::length_error("native inverse conversion exceeds its membership bound");
+            memberships += summary.fields;
+            if (!summary.owner_live) continue;
+            live |= UINT64_C(1) << slot;
+            if (kind == EntityPropertyOwnerKind::EPOK_NODE) static_cast<void>(entities.readNode(snapshot, owner.entity_id));
+            else static_cast<void>(entities.readEdge(snapshot, owner.entity_id));
+            owners.push_back({owner, summary.fields});
+        }
+        hybrid_property_detail::require(live == group->live && memberships == group->memberships,
+            "native inverse conversion group counts disagree with actual live owner memberships");
+        rows_.reserve(owners.size());
+        // Complete bounded metadata preflight before allocating/decoding values.
+        struct DecodeOwner { HybridPropertyRowPreparation &result; const decltype(check) &checkpoint; } decodeOwner{*this, check};
+        property_decode::AllocationScope decoding(&decodeOwner,
+            [](void *owner, size_t bytes) {
+                auto &credit = static_cast<DecodeOwner *>(owner)->result.decoded_credit_;
+                credit.set(utils::detail::addStandardHeapBytes(credit.bytes(), bytes));
+            }, [](void *owner) { static_cast<DecodeOwner *>(owner)->checkpoint(); });
+        const uint32_t type = kind == EntityPropertyOwnerKind::EPOK_NODE ? Node::typeId : Edge::typeId;
+        for (const auto &owner : owners) {
+            check();
+            // Supported debug STLs may allocate proxy storage on empty/moved
+            // vector construction. Admit the bounded move frontier up front.
+            decoded_credit_.set(utils::detail::addStandardHeapBytes(decoded_credit_.bytes(),
+                3U * utils::detail::standardContainerProxyBytes()));
+            auto collection = HybridPropertyValueReader::readCollection(context, snapshot, owner.key, type, largeValues);
+            hybrid_property_detail::require(collection.routed, "native inverse conversion lost its pinned source route");
+            if (collection.value) {
+                const auto &row = *collection.value;
+                hybrid_property_detail::require(row.owner_entity_id == owner.key.entity_id && row.owner_entity_type == type &&
+                    row.entries.size() == owner.fields, "native inverse conversion changed its source owner or field count");
+                rows_.push_back(std::move(*collection.value));
+            } else {
+                hybrid_property_detail::require(!owner.fields, "native inverse conversion lost a nonempty source owner");
+                rows_.push_back({owner.key.entity_id, type, {}});
+            }
+        }
+        check();
+    }
+    HybridPropertyRowPreparation(const HybridPropertyRowPreparation &) = delete;
+    HybridPropertyRowPreparation &operator=(const HybridPropertyRowPreparation &) = delete;
+    HybridPropertyRowPreparation(HybridPropertyRowPreparation &&) noexcept = default;
+    HybridPropertyRowPreparation &operator=(HybridPropertyRowPreparation &&) = delete;
+    [[nodiscard]] std::span<const PropertyCollectionRoot> rows() const & noexcept { return rows_; }
+    std::span<const PropertyCollectionRoot> rows() const && = delete;
+    [[nodiscard]] DatabaseId databaseId() const noexcept { return database_id_; }
+    [[nodiscard]] Generation sourceGeneration() const noexcept { return source_generation_; }
+    [[nodiscard]] HybridPropertyGroupRecord sourceGroup() const noexcept { return source_group_; }
+};
+} // namespace graph::storage
