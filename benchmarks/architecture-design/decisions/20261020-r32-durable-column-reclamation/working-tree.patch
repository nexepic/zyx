@@ -0,0 +1,68 @@
+/**
+ * @file HybridPropertyLargeFieldInspection.hpp
+ * @brief Pinned bounded authentication and inspection of one native large field.
+ * Copyright (c) 2026 Nexepic. Licensed under Apache-2.0.
+ */
+#pragma once
+#include "graph/core/PropertyDecodeAllocationScope.hpp"
+#include "graph/storage/relocatable/property/HybridPropertyReadContext.hpp"
+#include "graph/storage/relocatable/property/LargeValueStore.hpp"
+#include "graph/utils/OwnedHeapReservation.hpp"
+
+namespace graph::storage {
+// The context, pin, field view and store must outlive this synchronous helper.
+// The manifest and at most one authenticated chunk remain between range calls.
+// Credits precede their backing objects so destruction cannot refund buffers
+// still held by another member.
+class HybridPropertyLargeFieldInspection final {
+    const HybridPropertyReadContext &context_;
+    const MetadataSnapshotPin &snapshot_;
+    const HybridPropertyExtensionView &field_;
+    const LargeValueStore &values_;
+    utils::OwnedHeapReservation manifest_credit_, range_credit_, directory_credit_;
+    LargeValueStore::RangeReadCache cache_;
+    LargeValueManifest manifest_;
+public:
+    HybridPropertyLargeFieldInspection(const HybridPropertyReadContext &context, const MetadataSnapshotPin &snapshot,
+        const HybridPropertyExtensionView &field, const LargeValueStore &values,
+        const std::shared_ptr<std::pmr::memory_resource> &memory)
+        : context_(context), snapshot_(snapshot), field_(field), values_(values),
+          manifest_credit_(memory), range_credit_(memory), directory_credit_(memory) {
+        hybrid_property_detail::require(context.usesSnapshot(snapshot) &&
+            field.mode() == HybridPropertyExtensionMode::HPEM_LARGE_REFERENCE && field.reference(),
+            "hybrid large inspection requires its pinned field and store");
+        const auto admit = [&](size_t bytes) { manifest_credit_.set(bytes); };
+        const auto checkpoint = [&] { check(); };
+        manifest_ = values_.verifyContent(snapshot_, *field_.reference(), std::ref(admit), std::ref(checkpoint));
+    }
+    HybridPropertyLargeFieldInspection(const HybridPropertyLargeFieldInspection &) = delete;
+    HybridPropertyLargeFieldInspection &operator=(const HybridPropertyLargeFieldInspection &) = delete;
+    [[nodiscard]] CanonicalPropertyValueCodec::DecodeShape inspect() {
+        const auto read = [&](size_t offset, std::span<std::byte> bytes) { readRange(offset, bytes); };
+        const auto admit = [&](size_t bytes) { directory_credit_.set(bytes); };
+        const auto checkpoint = [&] { check(); };
+        return field_.inspectLargePayloadRange(std::ref(read), std::ref(admit), std::ref(checkpoint));
+    }
+    [[nodiscard]] bool isNull() {
+        const auto read = [&](size_t offset, std::span<std::byte> bytes) { readRange(offset, bytes); };
+        const auto admit = [&](size_t bytes) { directory_credit_.set(bytes); };
+        const auto checkpoint = [&] { check(); };
+        return field_.largePayloadRangeIsNull(std::ref(read), std::ref(admit), std::ref(checkpoint));
+    }
+private:
+    void check() const {
+        context_.checkpoint();
+        if (auto *scope = property_decode::AllocationScope::current()) scope->checkpoint();
+    }
+    void readRange(size_t offset, std::span<std::byte> target) {
+        check();
+        const auto admit = [&](size_t bytes) { range_credit_.set(bytes); };
+        {
+            const auto bytes = values_.readRangeFromManifestCached(snapshot_, manifest_, offset,
+                target.size(), cache_, std::ref(admit));
+            std::copy(bytes.begin(), bytes.end(), target.begin());
+        }
+        range_credit_.set(cache_.retainedBytes());
+    }
+};
+} // namespace graph::storage
diff --git a/src/storage/relocatable/metadata/RelocatableMetadataStoreHybridMutation.cpp b/src/storage/relocatable/metadata/RelocatableMetadataStoreHybridMutation.cpp
new file mode 100644
index 00000000..1e617f4f
--- /dev/null
+++ b/src/storage/relocatable/metadata/RelocatableMetadataStoreHybridMutation.cpp
@@ -0,0 +1,355 @@
+/**
+ * @file RelocatableMetadataStoreHybridMutation.cpp
+ * @brief Atomic inverse publication of the isolated native property candidate.
+ * Copyright (c) 2026 Nexepic. Licensed under Apache-2.0.
+ */
+#include "graph/storage/relocatable/metadata/RelocatableMetadataStore.hpp"
+#include "graph/storage/relocatable/metadata/HybridPropertyRowPreparation.hpp"
+#include "graph/storage/relocatable/metadata/HybridPropertyColumnWritePreparation.hpp"
+#include "graph/storage/relocatable/property/HybridPropertyDirectoryIntegrity.hpp"
+#include "graph/storage/relocatable/index/BTreePageStore.hpp"
+#include "graph/debug/PerfTrace.hpp"
+#include "graph/query/execution/MaterializedByteBudget.hpp"
+#include "graph/storage/relocatable/schema/SystemCatalog.hpp"
+#include <algorithm>
+#include <optional>
+
+namespace graph::storage {
+Superblock RelocatableMetadataStore::mutateHybridPropertyColumns(const NativeHybridPropertyColumnWrite &request,
+    LogSequenceNumber checkpointLsn, const MetadataPublishOptions &options) {
+    if (!RSS_HYBRID_PROPERTY_FORMAT_ENABLED)
+        throw FormatException(FormatError::FERR_UNSUPPORTED_VERSION, "native column publication is disabled");
+    const auto require = [](bool valid, const char *message) { hybrid_property_detail::require(valid, message); };
+    const auto check = [&] { if (request.cancellation) request.cancellation->check(); };
+    require(request.memory && !request.replacements.empty() && request.replacements.size() <= RSS_HYBRID_GROUP_CAPACITY &&
+        request.first_slot.isValid() && request.last_slot >= request.first_slot && request.field_pool_owner_id,
+        "native column publication requires a bounded replacement set and destination range");
+    const auto account = std::dynamic_pointer_cast<query::execution::MaterializedByteBudget>(request.memory);
+    constexpr size_t maximumBytes = 1024U * 1024U;
+    require(account && account->used() <= maximumBytes && account->available() <= maximumBytes - account->used(),
+        "native column publication requires an account of at most one MiB");
+    check(); utils::OwnedAllocationScope scope(request.memory);
+    SlottedPagePool sourcePages(io_, *this, SharedPagePoolOpenMode::SPPOM_READ_ONLY);
+    auto writer = beginWrite(true); const auto current = bootstrap_.recover();
+    require(current.database_id == request.expected_database_id && current.generation == request.expected_generation &&
+        current.hybrid_property_descriptor_root.isValid() && current.hybrid_property_descriptor_root == request.expected_descriptor,
+        "native column publication has a stale or foreign source fence");
+    // Schema indexes/constraints require the general derived-state coordinator.
+    // This isolated primitive cannot silently leave such structures stale.
+    require(!locations_.findIndexRootOptional(current, RSS_SYSTEM_CATALOG_INDEX_ID),
+        "isolated native column publication cannot bypass schema-derived state");
+    auto source = snapshots_.pinCurrentUnderWrite(writer, current);
+    MetadataWriteBatch batch(metadata_page_pool_, current, checkpointLsn, request.memory);
+    HybridPropertyReadContext context(io_, sourcePages, *this, source, request.cancellation);
+    HybridPropertyFieldPageStore fields(io_, *this, source);
+    utils::OwnedVector<HybridPropertyColumnDelta> deltas{utils::OwnedPmrAllocator<HybridPropertyColumnDelta>(request.memory)};
+    utils::OwnedVector<const HybridPropertyColumnDelta *> changes{utils::OwnedPmrAllocator<const HybridPropertyColumnDelta *>(request.memory)};
+    deltas.reserve(request.replacements.size()); changes.reserve(request.replacements.size());
+    for (const auto &replacement : request.replacements) {
+        check();
+        const auto value = std::visit([](const auto &cell) -> PropertyValue {
+            if constexpr (std::is_same_v<std::decay_t<decltype(cell)>, std::monostate>) return PropertyValue();
+            else return PropertyValue(cell);
+        }, replacement.value);
+        auto delta = HybridPropertyColumnDelta::planExistingColumn(context, source, replacement.owner,
+            replacement.token, batch.generation(), request.memory, &value);
+        require(bool(delta), "native column replacement does not name an existing column member");
+        deltas.push_back(std::move(*delta));
+    }
+    for (const auto &delta : deltas) changes.push_back(&delta);
+    HybridPropertyColumnWritePreparation prepared(source, fields, changes, request.memory, request.cancellation);
+    if (prepared.pages_.empty()) { check(); return current; }
+    utils::OwnedVector<CatalogEntry> oldPools{utils::OwnedPmrAllocator<CatalogEntry>(request.memory)};
+    oldPools.reserve(prepared.pages_.size());
+    for (const auto &page : prepared.pages_) {
+        const auto location = locations_.findPage(current, page.pageId()); oldPools.push_back(catalog_.find(current, location.segment_id));
+    }
+    std::sort(oldPools.begin(), oldPools.end(), [](const auto &a, const auto &b) { return a.segment_id < b.segment_id; });
+    oldPools.erase(std::unique(oldPools.begin(), oldPools.end(), [](const auto &a, const auto &b) { return a.segment_id == b.segment_id; }), oldPools.end());
+    SharedPagePoolAllocator sourcePools(io_, *this, source);
+    for (auto pool = oldPools.begin(); pool != oldPools.end();) {
+        check(); bool detached = pool->state == SegmentState::SGS_SEALED && pool->kind == SegmentKind::SGK_PROPERTY_PAGE_POOL &&
+            allocator_.isAllocated(current, pool->physical_slot);
+        if (detached) {
+            const auto header = SharedPagePoolAllocator::readPoolHeader(*io_, current.data_region_offset, *pool);
+            for (uint8_t frame = RSS_PAGE_POOL_FIRST_DATA_FRAME; frame <= RSS_PAGE_POOL_DATA_FRAME_COUNT; ++frame) {
+                check(); if (!SharedPagePoolFrameMap::isAllocated(header, frame)) continue;
+                const auto owner = sourcePools.readPageOwner(*pool, frame);
+                const auto routed = locations_.findPageOptional(current, owner.page_id);
+                if (routed && routed->segment_id == pool->segment_id && routed->generation == pool->generation && routed->page_index == frame)
+                    detached = detached && owner.flags == 0 && std::any_of(prepared.pages_.begin(), prepared.pages_.end(),
+                        [&](const auto &page) { return page.pageId() == owner.page_id; });
+            }
+        }
+        if (!detached) { pool = oldPools.erase(pool); continue; }
+        batch.reserveDataSlot(pool->physical_slot); pool->state = SegmentState::SGS_RETIRED; ++pool;
+    }
+    utils::OwnedVector<CatalogEntry> newPools{utils::OwnedPmrAllocator<CatalogEntry>(request.memory)};
+    utils::OwnedVector<PageLocation> published{utils::OwnedPmrAllocator<PageLocation>(request.memory)};
+    newPools.reserve(prepared.pages_.size()); published.reserve(prepared.pages_.size());
+    std::optional<uint64_t> nextSlot = request.first_slot.value();
+    for (size_t offset = 0; offset < prepared.pages_.size();) {
+        check(); std::optional<CatalogEntry> destination;
+        while (nextSlot) {
+            const auto free = allocator_.findFirstFree(current, PhysicalSlotId(*nextSlot), request.last_slot);
+            if (!free) break;
+            nextSlot = *free == request.last_slot ? std::nullopt : std::optional(free->value() + 1U);
+            if (batch.isDataSlotReserved(*free) || batch.isMetadataPoolSlot(*free)) continue;
+            destination = CatalogEntry{batch.allocateLogicalSegmentId(), *free, SegmentKind::SGK_PROPERTY_PAGE_POOL,
+                request.field_pool_owner_id, Generation(1), SegmentState::SGS_SEALED, batch.checkpointLsn()};
+            batch.reserveDataSlot(*free); break;
+        }
+        require(bool(destination), "native column publication has no free destination pool");
+        const auto pool = *destination; newPools.push_back(pool);
+        const auto count = std::min(size_t(RSS_PAGE_POOL_DATA_FRAME_COUNT), prepared.pages_.size() - offset);
+        utils::OwnedHeapReservation payloadCredit(request.memory, count *
+            (utils::detail::standardAllocatorRequestBytes(RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, alignof(std::byte)) +
+                3U * utils::detail::standardContainerProxyBytes()));
+        utils::OwnedVector<SharedPagePoolPreparedAppend> appends{utils::OwnedPmrAllocator<SharedPagePoolPreparedAppend>(request.memory)};
+        utils::OwnedVector<PageLocation> locations{utils::OwnedPmrAllocator<PageLocation>(request.memory)};
+        appends.reserve(count); locations.reserve(count);
+        for (size_t i = 0; i < count; ++i) {
+            check(); auto &image = prepared.pages_[offset + i];
+            const PageOwnerHeader owner{image.pageId(), pool.owner_id, PageOwnerKind::POK_HYBRID_PROPERTY, 0,
+                RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, pool.generation, batch.checkpointLsn()};
+            utils::OwnedHeapReservation referenceCredit(request.memory);
+            auto page = std::move(image).bindPrivateOwner(owner, pool, batch.checkpointLsn(),
+                [&](size_t bytes) { referenceCredit.set(bytes); });
+            const auto bytes = page.serializeOwned(request.memory);
+            SharedPagePoolPreparedAppend append; append.owner = owner; append.free_bytes = page.stats().contiguous_free_bytes;
+            append.payload.assign(bytes.begin(), bytes.end()); appends.push_back(std::move(append));
+            locations.push_back({page.pageId(), pool.segment_id, 0, pool.generation, page.stats().contiguous_free_bytes});
+        }
+        check();
+        SharedPagePoolAllocator::prepareNewPoolPagesUnderWrite(*io_, current.data_region_offset, pool,
+            appends, locations, batch.checkpointLsn(), 0, true);
+        for (const auto &location : locations) published.push_back(location);
+        offset += count;
+    }
+    for (const auto &pool : newPools) allocator_.prepareSetAllocated(batch, pool.physical_slot, true);
+    catalog_.prepareUpsert(batch, newPools);
+    std::sort(published.begin(), published.end(), [](const auto &a, const auto &b) { return a.page_id < b.page_id; });
+    locations_.prepareUpsertPages(batch, published);
+    utils::OwnedVector<RetireQueueEntry> retirements{utils::OwnedPmrAllocator<RetireQueueEntry>(request.memory)};
+    retirements.reserve(oldPools.size());
+    for (const auto &pool : oldPools)
+        retirements.push_back({pool.physical_slot, pool.segment_id, batch.generation(), RetireQueueDisposition::RQD_RETIRED_SEGMENT});
+    std::sort(retirements.begin(), retirements.end(), [](const auto &a, const auto &b) { return a.physical_slot < b.physical_slot; });
+    if (!oldPools.empty()) { catalog_.prepareUpsert(batch, oldPools); retirement_.prepareQueueInsertions(batch, retirements); }
+    auto descriptor = pages_.readHybridPropertyDescriptor(current.hybrid_property_descriptor_root, current).descriptor;
+    descriptor.semantic_generation = batch.generation(); pages_.prepareHybridPropertyDescriptorImpl(batch, descriptor, true);
+    batch.hybrid_property_publication_ = true;
+    check(); publishBatch(batch, writer, options); return batch.candidate();
+}
+
+Superblock RelocatableMetadataStore::publishHybridPropertyRows(MetadataWriteBatch &batch,
+    const MetadataWriteGuard &writer, const MetadataSnapshotPin &source,
+    const NativeGraphHybridPropertyConversion &conversion, EntityPageStore &entities,
+    SlottedPagePool &sourcePages, BTreePageStore &sourceTrees, LargeValueStore &largeValues,
+    const MetadataPublishOptions &options) {
+    const auto require = [](bool valid, const char *message) { hybrid_property_detail::require(valid, message); };
+    const auto &current = batch.current();
+    require(RSS_HYBRID_PROPERTY_FORMAT_ENABLED && source.superblock() == current && snapshots_.owns(source) &&
+        current.hybrid_property_descriptor_root.isValid() && entities.usesMetadataStore(*this) &&
+        sourcePages.usesMetadataStore(*this) && sourceTrees.usesMetadataStore(*this) && largeValues.usesMetadataStore(*this),
+        "inverse native conversion requires its exact writer source and typed stores");
+    utils::OwnedAllocationScope scope(conversion.memory);
+    const auto check = [&] { if (conversion.cancellation) conversion.cancellation->check(); };
+    check();
+    const auto descriptor = pages_.readHybridPropertyDescriptor(current.hybrid_property_descriptor_root, current).descriptor;
+    const size_t base = conversion.owner_kind == EntityPropertyOwnerKind::EPOK_NODE ? 0U : 4U;
+    for (size_t i = 0; i < descriptor.roots.size(); ++i)
+        require((i >= base && i < base + 4) || !descriptor.roots[i].page_id.isValid(),
+            "inverse prototype cannot erase another owner namespace");
+    HybridPropertyReadContext context(io_, sourcePages, *this, source, conversion.cancellation);
+    HybridPropertyRowPreparation projection(context, source, *this, entities, conversion.owner_kind,
+        conversion.group_id, conversion.memory, &largeValues, conversion.cancellation);
+    // This initial durable prototype has exactly one converted group. Do not
+    // rebuild or erase shared directories belonging to other groups.
+    const auto groupBinding = HybridPropertyDirectoryCodec::bindRoot(descriptor, source,
+        static_cast<HybridPropertyRootOrdinal>(base + 3));
+    HybridPropertyGroupDirectoryMap groups(groupBinding.root.index_id, sourceTrees, *this, groupBinding);
+    utils::OwnedHeapReservation boundary(conversion.memory);
+    const auto admit = [&](size_t bytes) { boundary.set(bytes); };
+    utils::OwnedVector<PageId> fieldIds{utils::OwnedPmrAllocator<PageId>(conversion.memory)};
+    fieldIds.reserve(projection.sourceGroup().memberships + projection.sourceGroup().columns + 1U);
+    size_t groupCount = 0;
+    require(groups.visitAll(source, 2, [&](const auto &entry) {
+        check();
+        require(++groupCount == 1 && HybridPropertyDirectoryCodec::decodeGroupKey(entry.key) == conversion.group_id,
+            "inverse prototype requires exactly its selected source group");
+        fieldIds.push_back(HybridPropertyDirectoryCodec::decodeLocator(entry.value).page_id); return true;
+    }, std::ref(admit), conversion.cancellation) && groupCount == 1,
+        "inverse source group enumeration was incomplete");
+    static_cast<void>(HybridPropertyDirectoryIntegrity::verify(context, source, conversion.memory, &largeValues));
+    for (const auto role : {size_t(1), size_t(2)}) {
+        if (!descriptor.roots[base + role].page_id.isValid()) continue;
+        const auto binding = HybridPropertyDirectoryCodec::bindRoot(descriptor, source,
+            static_cast<HybridPropertyRootOrdinal>(base + role));
+        HybridPropertyFieldDirectoryMap map(binding.root.index_id, sourceTrees, *this, binding);
+        const size_t bound = role == 1 ? projection.sourceGroup().columns + 1U : projection.sourceGroup().memberships + 1U;
+        require(map.visitAll(source, bound, [&](const auto &entry) {
+            check(); fieldIds.push_back(HybridPropertyDirectoryCodec::decodeLocator(entry.value).page_id); return true;
+        }, std::ref(admit), conversion.cancellation), "inverse field directory enumeration was incomplete");
+    }
+    boundary.set(0);
+    std::sort(fieldIds.begin(), fieldIds.end()); fieldIds.erase(std::unique(fieldIds.begin(), fieldIds.end()), fieldIds.end());
+    for (const auto id : fieldIds) {
+        check(); static_cast<void>(HybridPropertyDirectoryIntegrity::verifyPageOwnership(context, source,
+            id, conversion.memory, &largeValues));
+    }
+    utils::OwnedVector<uint64_t> retiredIds{utils::OwnedPmrAllocator<uint64_t>(conversion.memory)};
+    retiredIds.reserve(fieldIds.size() + 4U * 128U);
+    for (const auto id : fieldIds) retiredIds.push_back(id.value());
+    utils::OwnedVector<uint64_t> erasedRoots{utils::OwnedPmrAllocator<uint64_t>(conversion.memory)};
+    erasedRoots.reserve(4);
+    for (size_t role = 0; role < 4; ++role) {
+        if (!descriptor.roots[base + role].page_id.isValid()) continue;
+        check();
+        // Existing bounded tree retirement authenticates every child and pool.
+        // Its standard set/map/vector/callback frontier is conservatively paid
+        // before construction and destroyed before this scratch credit refunds.
+        utils::OwnedHeapReservation treeScratch(conversion.memory, 256U * 1024U);
+        const auto id = hybridPropertyIndexId(static_cast<HybridPropertyRootOrdinal>(base + role));
+        const auto plan = sourceTrees.planTreeRetirement(source, id, 128, conversion.cancellation);
+        require(plan.expected_root.root_page_id == descriptor.roots[base + role].page_id &&
+            plan.expected_root.root_generation == descriptor.roots[base + role].generation,
+            "inverse directory retirement lost its descriptor root");
+        for (const auto &pool : plan.pool_requests)
+            for (const auto &page : pool.expected_retirements) retiredIds.push_back(page.location.page_id.value());
+        erasedRoots.push_back(id);
+    }
+    std::sort(retiredIds.begin(), retiredIds.end());
+    require(std::adjacent_find(retiredIds.begin(), retiredIds.end()) == retiredIds.end(),
+        "inverse native directory and field pages overlap");
+    utils::OwnedVector<CatalogEntry> retiredPools{utils::OwnedPmrAllocator<CatalogEntry>(conversion.memory)};
+    retiredPools.reserve(retiredIds.size());
+    for (const auto id : retiredIds) {
+        check(); const auto location = locations_.findPage(current, PageId(id));
+        retiredPools.push_back(catalog_.find(current, location.segment_id));
+    }
+    std::sort(retiredPools.begin(), retiredPools.end(), [](const auto &left, const auto &right) { return left.segment_id < right.segment_id; });
+    retiredPools.erase(std::unique(retiredPools.begin(), retiredPools.end(), [](const auto &left, const auto &right) {
+        return left.segment_id == right.segment_id;
+    }), retiredPools.end());
+    SharedPagePoolAllocator sourcePools(io_, *this, source);
+    for (auto &pool : retiredPools) {
+        check();
+        require(pool.state == SegmentState::SGS_SEALED && allocator_.isAllocated(current, pool.physical_slot) &&
+            (pool.kind == SegmentKind::SGK_PROPERTY_PAGE_POOL || pool.kind == SegmentKind::SGK_INDEX_PAGE_POOL),
+            "inverse retirement has an incompatible source pool");
+        const auto header = SharedPagePoolAllocator::readPoolHeader(*io_, current.data_region_offset, pool);
+        for (uint8_t frame = RSS_PAGE_POOL_FIRST_DATA_FRAME; frame <= RSS_PAGE_POOL_DATA_FRAME_COUNT; ++frame) {
+            check(); if (!SharedPagePoolFrameMap::isAllocated(header, frame)) continue;
+            const auto owner = sourcePools.readPageOwner(pool, frame);
+            const auto routed = locations_.findPageOptional(current, owner.page_id);
+            if (routed && routed->segment_id == pool.segment_id && routed->generation == pool.generation && routed->page_index == frame)
+                require(owner.flags == 0 && std::binary_search(retiredIds.begin(), retiredIds.end(), owner.page_id.value()),
+                    "inverse pool retirement would remove an unrelated current frame");
+        }
+        batch.reserveDataSlot(pool.physical_slot); pool.state = SegmentState::SGS_RETIRED;
+    }
+    struct RowImage { CatalogEntry pool; PageLocation location; SlottedPage page; };
+    utils::OwnedVector<CatalogEntry> newPools{utils::OwnedPmrAllocator<CatalogEntry>(conversion.memory)};
+    utils::OwnedVector<RowImage> images{utils::OwnedPmrAllocator<RowImage>(conversion.memory)};
+    utils::OwnedVector<EntityPropertyLocation> properties{utils::OwnedPmrAllocator<EntityPropertyLocation>(conversion.memory)};
+    properties.reserve(projection.rows().size()); images.reserve(projection.rows().size()); newPools.reserve(projection.rows().size());
+    std::optional<uint64_t> nextSlot = conversion.first_slot.value();
+    const auto newPool = [&] {
+        while (nextSlot) {
+            check(); const auto free = allocator_.findFirstFree(current, PhysicalSlotId(*nextSlot), conversion.last_slot);
+            if (!free) break;
+            nextSlot = *free == conversion.last_slot ? std::nullopt : std::optional(free->value() + 1U);
+            if (batch.isDataSlotReserved(*free) || batch.isMetadataPoolSlot(*free)) continue;
+            CatalogEntry pool{batch.allocateLogicalSegmentId(), *free, SegmentKind::SGK_PROPERTY_PAGE_POOL,
+                conversion.field_pool_owner_id, Generation(1), SegmentState::SGS_SEALED, batch.checkpointLsn()};
+            batch.reserveDataSlot(pool.physical_slot); newPools.push_back(pool); return pool;
+        }
+        throw FormatException(FormatError::FERR_INVALID_STATE, "inverse native conversion has no free destination pool");
+    };
+    // Pay the existing canonical encoder's bounded standard-vector frontier.
+    // Reject roots lacking a supported ROW carrier before writing any frame.
+    utils::OwnedHeapReservation encodingScratch(conversion.memory, 64U * 1024U);
+    for (const auto &row : projection.rows()) {
+        check(); if (row.entries.empty()) continue;
+        size_t encodedSize = RSS_ENTITY_PROPERTY_COLLECTION_ROOT_HEADER_BYTES;
+        for (const auto &entry : row.entries) {
+            check(); encodedSize = utils::detail::addStandardHeapBytes(encodedSize,
+                utils::detail::addStandardHeapBytes(8U, CanonicalPropertyValueCodec::encodedSize(entry.value)));
+        }
+        utils::OwnedVector<std::byte> encoded{utils::OwnedPmrAllocator<std::byte>(conversion.memory)};
+        if (encodedSize <= RSS_HYBRID_EXTENSION_MAX_RECORD_BYTES) {
+            const auto bytes = EntityPropertyCollectionRootCodec::encode(row);
+            require(bytes.size() == encodedSize, "inverse ROW encoder size disagrees with preflight");
+            encoded.assign(bytes.begin(), bytes.end());
+        } else if (row.entries.size() == 1) {
+            utils::OwnedHeapReservation referenceCredit(conversion.memory);
+            const auto referenceAdmission = [&](size_t bytes) { referenceCredit.set(bytes); };
+            const auto extension = [&](const HybridPropertyExtensionView &value) {
+                if (!value.reference()) return;
+                const EntityPropertyLargeValueReference reference{row.owner_entity_id, row.owner_entity_type, *value.reference()};
+                const auto bytes = EntityPropertyLargeValueReferenceCodec::encode(reference);
+                encoded.assign(bytes.begin(), bytes.end());
+            };
+            static_cast<void>(context.visitField({conversion.owner_kind, row.owner_entity_id}, row.entries[0].key_token,
+                [](const auto &) {}, std::ref(extension), std::ref(admit), std::ref(referenceAdmission)));
+            boundary.set(0);
+        }
+        if (encoded.empty() || encoded.size() > RSS_HYBRID_EXTENSION_MAX_RECORD_BYTES)
+            throw FormatException(FormatError::FERR_UNSUPPORTED_VERSION,
+                "inverse native conversion needs the complete ROW LargeValue carrier lifecycle");
+        if (images.empty() || images.back().page.stats().contiguous_free_bytes < encoded.size() + RSS_SLOTTED_PAGE_SLOT_BYTES) {
+            if (newPools.empty() || images.size() % RSS_PAGE_POOL_DATA_FRAME_COUNT == 0) static_cast<void>(newPool());
+            const auto pool = newPools.back(); const auto pageId = batch.allocateLogicalPageId();
+            const PageOwnerHeader owner{pageId, pool.owner_id, PageOwnerKind::POK_PROPERTY, 0,
+                RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, pool.generation, batch.checkpointLsn()};
+            auto page = SlottedPage::create(owner);
+            images.push_back({pool, {pageId, pool.segment_id, uint16_t(RSS_PAGE_POOL_FIRST_DATA_FRAME + images.size() % RSS_PAGE_POOL_DATA_FRAME_COUNT),
+                pool.generation, 0}, std::move(page)});
+        }
+        auto &image = images.back(); const auto slot = image.page.insert(encoded);
+        image.location.free_bytes = image.page.stats().contiguous_free_bytes;
+        properties.push_back({{conversion.owner_kind, row.owner_entity_id}, slot.page_id, slot.slot_id, slot.generation});
+    }
+    encodingScratch.set(0);
+    debug::PerfTrace::addValue("native_graph.hybrid.inverse_private_row_frames", int64_t(images.size()));
+    check();
+    if (!conversion.publish_candidate)
+        throw FormatException(FormatError::FERR_UNSUPPORTED_VERSION, "inverse native ROW preparation completed; publication was not requested");
+    utils::OwnedVector<PageLocation> published{utils::OwnedPmrAllocator<PageLocation>(conversion.memory)};
+    published.reserve(images.size());
+    for (const auto &pool : newPools) {
+        check(); const auto count = size_t(std::count_if(images.begin(), images.end(), [&](const auto &image) { return image.pool.segment_id == pool.segment_id; }));
+        utils::OwnedHeapReservation payloadCredit(conversion.memory, count *
+            (utils::detail::standardAllocatorRequestBytes(RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, alignof(std::byte)) +
+                3U * utils::detail::standardContainerProxyBytes()));
+        utils::OwnedVector<SharedPagePoolPreparedAppend> appends{utils::OwnedPmrAllocator<SharedPagePoolPreparedAppend>(conversion.memory)};
+        utils::OwnedVector<PageLocation> locations{utils::OwnedPmrAllocator<PageLocation>(conversion.memory)};
+        appends.reserve(count); locations.reserve(count);
+        for (const auto &image : images) {
+            if (image.pool.segment_id != pool.segment_id) continue;
+            check(); const auto bytes = image.page.serializeOwned(conversion.memory);
+            SharedPagePoolPreparedAppend append;
+            append.owner = {image.location.page_id, pool.owner_id, PageOwnerKind::POK_PROPERTY, 0,
+                RSS_PAGE_OWNER_MAX_PAYLOAD_BYTES, pool.generation, batch.checkpointLsn()};
+            append.payload.assign(bytes.begin(), bytes.end()); append.free_bytes = image.location.free_bytes;
+            appends.push_back(std::move(append)); auto location = image.location; location.page_index = 0; locations.push_back(location);
+        }
+        SharedPagePoolAllocator::prepareNewPoolPagesUnderWrite(*io_, current.data_region_offset, pool, appends, locations, batch.checkpointLsn());
+        for (const auto &location : locations) published.push_back(location);
+    }
+    for (const auto &pool : newPools) allocator_.prepareSetAllocated(batch, pool.physical_slot, true);
+    if (!newPools.empty()) catalog_.prepareUpsert(batch, newPools);
+    locations_.prepareReplacePages(batch, published, retiredIds);
+    locations_.prepareReplaceIndexRoots(batch, {}, erasedRoots);
+    if (!properties.empty()) locations_.prepareReplaceEntityProperties(batch, properties, {});
+    utils::OwnedVector<RetireQueueEntry> retirements{utils::OwnedPmrAllocator<RetireQueueEntry>(conversion.memory)};
+    retirements.reserve(retiredPools.size());
+    for (const auto &pool : retiredPools)
+        retirements.push_back({pool.physical_slot, pool.segment_id, batch.generation(), RetireQueueDisposition::RQD_RETIRED_SEGMENT});
+    std::sort(retirements.begin(), retirements.end(), [](const auto &left, const auto &right) { return left.physical_slot < right.physical_slot; });
+    catalog_.prepareUpsert(batch, retiredPools); retirement_.prepareQueueInsertions(batch, retirements);
+    batch.setHybridPropertyDescriptorRoot({}); batch.hybrid_property_publication_ = true;
+    check(); publishBatch(batch, writer, options); return batch.candidate();
+}
+} // namespace graph::storage
diff --git a/tests/src/query/api/test_QueryEngineAnchorPlanning.cpp b/tests/src/query/api/test_QueryEngineAnchorPlanning.cpp
new file mode 100644
index 00000000..2ae55c6a
--- /dev/null
+++ b/tests/src/query/api/test_QueryEngineAnchorPlanning.cpp
@@ -0,0 +1,63 @@
+#include <gtest/gtest.h>
+#include "graph/query/api/QueryEngine.hpp"
+#include "graph/storage/LogicalGraphRead.hpp"
+#include "graph/query/logical/operators/LogicalTraversal.hpp"
+
+namespace graph::query {
+namespace {
+class AnchorPlanningBackend final : public storage::LogicalGraphReadBackend,
+    public storage::LogicalGraphStatisticsBackend {
+public:
+    mutable size_t planning_reads = 0, label_reads = 0, snapshot_opens = 0;
+    bool missing_batch = false, unknown_label = false;
+    std::unique_ptr<storage::LogicalGraphReadSnapshot> openLogicalGraphReadSnapshot() const override {
+        ++snapshot_opens; throw std::logic_error("planning must not scan the graph");
+    }
+    std::optional<storage::LogicalGraphCardinalityStatistics> readLogicalGraphCardinalityStatistics() const override {
+        return storage::LogicalGraphCardinalityStatistics{7, 11};
+    }
+    std::optional<uint64_t> estimateLogicalNodeCardinality(std::span<const std::string>) const override {
+        ++label_reads; return unknown_label ? std::nullopt : std::optional<uint64_t>(1);
+    }
+    storage::LogicalGraphPlanningStatistics readLogicalPlanningStatistics(
+        std::span<const std::vector<std::string>> labels) const override {
+        ++planning_reads;
+        if (missing_batch) return {*readLogicalGraphCardinalityStatistics(), {}};
+        return storage::LogicalGraphStatisticsBackend::readLogicalPlanningStatistics(labels);
+    }
+};
+const logical::LogicalTraversal *findTraversal(const logical::LogicalOperator &root) {
+    if (const auto *traversal = dynamic_cast<const logical::LogicalTraversal *>(&root)) return traversal;
+    for (const auto *child : root.getChildren()) if (child) {
+        if (const auto *found = findTraversal(*child)) return found;
+    }
+    return nullptr;
+}
+}
+TEST(QueryEngineAnchorPlanningTest, OpaqueReadEnvelopesDoNotRequestUnusableAnchorStatistics) {
+    for (const auto *query : {
+        "MATCH (a)-[r]-(b:Rare) RETURN a,b LIMIT 1",
+        "MATCH (a)-[r]-(b:Rare) RETURN a,b SKIP 1",
+        "MATCH (a)-[r]-(b:Rare) RETURN DISTINCT a,b",
+        "MATCH (a)-[r]-(b:Rare) RETURN a.rank,b",
+        "MATCH (a)-[r]-(b:Rare) RETURN rand(),a,b"}) {
+        SCOPED_TRACE(query);
+        auto backend = std::make_shared<AnchorPlanningBackend>(); QueryEngine engine(backend);
+        const auto plan = engine.buildPlan(query); ASSERT_TRUE(plan.root);
+        const auto *traversal = findTraversal(*plan.root); ASSERT_NE(traversal, nullptr);
+        EXPECT_EQ(traversal->getSourceVar(), "a"); EXPECT_EQ(backend->label_reads, 0U);
+        EXPECT_EQ(backend->planning_reads, 1U); EXPECT_EQ(backend->snapshot_opens, 0U);
+    }
+}
+TEST(QueryEngineAnchorPlanningTest, TransparentReadsUseOneFrozenBatchAndUnknownCountsKeepTheOriginalAnchor) {
+    for (int mode : {0, 1, 2}) {
+        auto backend = std::make_shared<AnchorPlanningBackend>();
+        backend->missing_batch = mode == 1; backend->unknown_label = mode == 2;
+        QueryEngine engine(backend); const auto plan = engine.buildPlan("MATCH (a)-[r]-(b:Rare) RETURN a,b");
+        const auto *traversal = findTraversal(*plan.root); ASSERT_NE(traversal, nullptr);
+        EXPECT_EQ(traversal->getSourceVar(), mode ? "a" : "b");
+        EXPECT_EQ(backend->label_reads, mode == 1 ? 0U : 1U);
+        EXPECT_EQ(backend->planning_reads, 1U); EXPECT_EQ(backend->snapshot_opens, 0U);
+    }
+}
+} // namespace graph::query
diff --git a/tests/src/storage/relocatable/adjacency/test_CoveredAdjacencyCandidate.cpp b/tests/src/storage/relocatable/adjacency/test_CoveredAdjacencyCandidate.cpp
new file mode 100644
index 00000000..6b2555bb
--- /dev/null
+++ b/tests/src/storage/relocatable/adjacency/test_CoveredAdjacencyCandidate.cpp
@@ -0,0 +1,294 @@
+#include <gtest/gtest.h>
+#include "graph/query/execution/MaterializedByteBudget.hpp"
+#include "graph/storage/relocatable/adjacency/CoveredAdjacencyCandidate.hpp"
+#include "graph/storage/relocatable/index/BulkBTreeBuilder.hpp"
+#include "graph/storage/relocatable/index/FixedBTreeMapMutation.hpp"
+#include "graph/storage/relocatable/maintenance/RelocatableCompactionCoordinator.hpp"
+#include "storage/relocatable/entity/NativeGraphWritePlannerTestFixture.hpp"
+
+using namespace graph::storage;
+namespace {
+constexpr uint64_t CANDIDATE_INDEX = 0x434F564552ULL; // laboratory-owned, not reserved/adopted
+using Candidate = CoveredAdjacencyCandidate;
+class CoveredAdjacencyCandidateTest : public graph::storage::test::NativeGraphWritePlannerTestFixture {
+protected:
+    uint64_t source = 0, target = 0;
+    std::vector<EntityRef> edges;
+    NativeGraphWritePlannerOptions options() const {
+        NativeGraphWritePlannerOptions o; o.first_slot = PhysicalSlotId(40); o.last_slot = PhysicalSlotId(100);
+        o.entity_pool_owner_id = 901; o.property_roots = {o.first_slot, o.last_slot, 902}; return o;
+    }
+    void seed() {
+        NativeGraphWritePlanner planner(*metadata_, *entities_, *labels_, *properties_, *btree_pages_, options());
+        auto tx = planner.beginTransaction(); source = tx.createNode({}); target = tx.createNode({});
+        std::vector<BTreePageEntry> records;
+        for (unsigned i = 0; i < 90; ++i) {
+            const auto neighbor = i == 89 ? source : target;
+            const auto id = tx.createEdge(source, neighbor, i % 3);
+            edges.push_back({id, true, source, neighbor, i % 3});
+            for (auto direction : {GlobalAdjacencyDirection::GAD_OUT, GlobalAdjacencyDirection::GAD_IN}) {
+                const auto e = Candidate::entry(direction, id, source, neighbor, i % 3);
+                const auto record = Candidate::Map::encode(e.key, e.value);
+                records.push_back({std::vector<std::byte>(record.begin(), record.end()), 0});
+            }
+        }
+        std::sort(records.begin(), records.end(), [](const auto &a, const auto &b) { return a.key < b.key; });
+        const OrderedBTreeEntrySource input = [&records]() -> OrderedBTreeEntryCursor {
+            return [&records, i = size_t{0}]() mutable -> std::optional<BTreePageEntry> {
+                if (i == records.size()) return {}; return records[i++];
+            };
+        };
+        const BulkBTreeBuildOptions build{PhysicalSlotId(40), PhysicalSlotId(100), CANDIDATE_INDEX,
+            records.size(), 32, BTreeLeafValueLayout::BLVL_EMPTY};
+        tx.stageScalarIndexCreate(*btree_pages_, BulkBTreeBuilder::planNativeTree(*btree_pages_, *metadata_,
+            tx.baseSnapshot(), CANDIDATE_INDEX, input, build));
+        ASSERT_TRUE(tx.commit().committed());
+    }
+    std::vector<uint64_t> scanAll(const MetadataSnapshotPin &pin, GlobalAdjacencyDirection direction, uint64_t node) {
+        std::vector<uint64_t> ids; std::optional<AdjacencyTopologyIdentity> continuation;
+        do {
+            const auto page = Candidate::scan(*btree_pages_, *entities_, *metadata_, pin, CANDIDATE_INDEX,
+                direction, node, 32, continuation);
+            EXPECT_LE(page.candidate_records, 33U);
+            for (const auto &edge : page.topology.entries()) ids.push_back(edge.entity_id);
+            continuation = page.continuation;
+        } while (continuation);
+        return ids;
+    }
+    void eraseBoth(NativeGraphWriteTransaction &tx, std::span<const EntityRef> removed) {
+        graph::query::execution::MaterializedByteBudget memory(65536);
+        FixedBTreeMapMutation<RSS_GLOBAL_ADJACENCY_KEY_BYTES, 16> changes(tx, *btree_pages_, *metadata_,
+            CANDIDATE_INDEX, 2 * removed.size(), memory);
+        for (const auto &edge : removed) {
+            tx.eraseEdge(edge.entity_id);
+            changes.erase(Candidate::key(GlobalAdjacencyDirection::GAD_OUT, edge.source_node_id, edge.entity_id));
+            changes.erase(Candidate::key(GlobalAdjacencyDirection::GAD_IN, edge.target_node_id, edge.entity_id));
+        }
+        changes.stage();
+    }
+};
+TEST_F(CoveredAdjacencyCandidateTest, NativeDoubleDirectionCreateDeleteRetainsOldPinsAndReopens) {
+    seed(); auto old = metadata_->openSnapshot();
+    auto ids = scanAll(old, GlobalAdjacencyDirection::GAD_OUT, source); ASSERT_EQ(ids.size(), 90U);
+    EXPECT_EQ(scanAll(old, GlobalAdjacencyDirection::GAD_IN, target).size(), 89U);
+    EXPECT_EQ(scanAll(old, GlobalAdjacencyDirection::GAD_IN, source), (std::vector<uint64_t>{edges.back().entity_id}));
+    const std::array removed{edges.front(), edges[2], edges.back()};
+    {
+        NativeGraphWritePlanner planner(*metadata_, *entities_, *labels_, *properties_, *btree_pages_, options());
+        auto tx = planner.beginTransaction(); eraseBoth(tx, removed); ASSERT_TRUE(tx.commit().committed());
+    }
+    auto fresh = metadata_->openSnapshot(); auto expected = ids;
+    for (const auto &edge : removed) std::erase(expected, edge.entity_id);
+    EXPECT_EQ(scanAll(old, GlobalAdjacencyDirection::GAD_OUT, source), ids);
+    EXPECT_EQ(scanAll(fresh, GlobalAdjacencyDirection::GAD_OUT, source), expected);
+    EXPECT_EQ(scanAll(fresh, GlobalAdjacencyDirection::GAD_IN, target).size(), 87U);
+    EXPECT_TRUE(scanAll(fresh, GlobalAdjacencyDirection::GAD_IN, source).empty());
+    old.release(); fresh.release(); reopenNativeStores();
+    auto reopened = metadata_->openSnapshot(); EXPECT_EQ(scanAll(reopened, GlobalAdjacencyDirection::GAD_OUT, source), expected);
+    {
+        NativeGraphWritePlanner planner(*metadata_, *entities_, *labels_, *properties_, *btree_pages_, options());
+        auto tx = planner.beginTransaction(); tx.stageScalarIndexDrop(*btree_pages_, CANDIDATE_INDEX, 32);
+        ASSERT_TRUE(tx.commit().committed());
+    }
+    EXPECT_EQ(scanAll(reopened, GlobalAdjacencyDirection::GAD_OUT, source), expected);
