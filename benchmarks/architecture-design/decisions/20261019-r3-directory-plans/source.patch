+    EXPECT_EQ(batch.current(), current); EXPECT_EQ(current.next_logical_page_id, 100U);
+    EXPECT_EQ(batch.allocatedPageCount(), 0U); EXPECT_EQ(batch.createdPoolCount(), 0U);
