+    auto source = Codec::sourceValue(HybridPropertySource::HPS_EXTENSION);
+    for (size_t offset : {size_t(1), size_t(2), size_t(3)}) {
+        auto bad = source; bad[offset] = std::byte{1}; EXPECT_THROW(Codec::decodeSource(bad), FormatException);
+    }
