+        }
+        for (unsigned slot = 0; slot < 64; ++slot) if (touched & (UINT64_C(1) << slot)) {
+            check(); const EntityPropertyKey owner{source->owner_kind, (source->group_id - 1U) * 64U + slot + 1U};
