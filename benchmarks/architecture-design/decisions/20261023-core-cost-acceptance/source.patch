+    {
+        StorageIO::ScopedNativeWriteHookForTesting observe([&](file_handle_t fd, const void *bytes, size_t count, pwrite_off_t offset) {
+            if (count == RSS_SUPERBLOCK_BYTES && offset >= 0 && uint64_t(offset) < RSS_FILE_BOOTSTRAP_BYTES)
