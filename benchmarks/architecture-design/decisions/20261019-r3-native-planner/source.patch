+        EXPECT_EQ(reopened.readGroup(groupSlot, g.owner_kind, 1, Generation(10)), newGroup);
+        EXPECT_EQ(reopened.readColumn(selected, changed.identity, newGroup, Generation(10)), changed);
+    }
