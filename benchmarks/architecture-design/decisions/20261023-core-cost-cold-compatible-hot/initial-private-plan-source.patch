+        EXPECT_EQ(value.entries.front().value, PropertyValue(id % 2 ? "US" : "DE"));
+    }
+    EXPECT_EQ(memory->used(), 0U);
+    EXPECT_NO_THROW((void)RelocatableIntegrityScanner(io_, *metadata_, memory).scan());
+}
